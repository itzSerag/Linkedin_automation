{
  "name": "linkedin_automation",
  "version": "2.0.0",
  "description": "LinkedIn Automation & Personal Branding Studio",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node --watch src/server.js\" \"npm run dev --prefix frontend\"",
    "server": "node src/server.js",
    "client": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node src/server.js"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "axios": "^1.21.0",
    "cloudinary": "^2.11.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "openai": "^4.86.1",
    "sharp": "^0.35.5"
  }
}
